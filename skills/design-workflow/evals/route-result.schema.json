{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "primary_skill": {
      "type": "string",
      "enum": ["design-workflow", "grill-me", "design-evidence", "design-inference", "design-docs"]
    },
    "mode": {
      "type": "string",
      "enum": ["governance", "grill", "competitor", "playtest", "implementation", "decision", "concept", "system", "feature", "unsupported"]
    },
    "profile": {
      "type": "string",
      "enum": ["brief", "standard", "implementation-ready", "full-package", "not-applicable"]
    },
    "supported": {
      "type": "boolean"
    },
    "reason": {
      "type": "string"
    }
  },
  "required": ["primary_skill", "mode", "profile", "supported", "reason"],
  "additionalProperties": false
}
